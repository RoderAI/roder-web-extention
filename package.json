{
  "name": "roder-chrome",
  "version": "0.2.0",
  "private": true,
  "description": "Chrome extension bridge for collaborative Roder/Gode browser control.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts-build-content.mjs && node scripts-write-manifest.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "eval:computer-use": "pnpm build && node scripts/eval-computer-use.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "playwright-core": "1.62.1",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.32.1"
}
